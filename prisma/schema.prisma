generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Symbol {
  ticker           String           @id
  name             String
  exchange         String           @default("NASDAQ")
  sector           String
  industry         String
  marketCap        Float
  isEtf            Boolean          @default(false)
  listedAt         DateTime?
  createdAt        DateTime         @default(now())
  processingStatus String?          @default("REGISTERED")
  batchId          String?
  generationId     String?
  dataQuality      String?          @default("UNKNOWN")
  nextRetrainAt    DateTime?        // scheduled retrain after drift detection
  retrainCount     Int              @default(0)
  alerts           Alert[]
  coefficients     Coefficient[]
  newsMentions     NewsItemSymbol[]
  metrics          ScoreSnapshot[]
  watchlistEntries WatchlistEntry[]
  retrainRuns     RetrainRun[]

  @@index([sector])
  @@index([marketCap])
  @@index([generationId], map: "idx_symbol_generationId")
  @@index([batchId], map: "idx_symbol_batchId")
  @@index([processingStatus], map: "idx_symbol_processingStatus")
  @@index([nextRetrainAt], map: "idx_symbol_nextRetrainAt")
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model BatchManifest {
  id                  String    @id @default(cuid())
  batchId             String    @unique
  batchIndex          Int?
  batchSize           Int?
  sourceRevision      String?
  sourceHash          String?
  selectedTickers     String?
  skippedTickers      String?
  failedTickers       String?
  startedAt           DateTime  @default(now())
  completedAt         DateTime?
  status              String    @default("RUNNING")
  rawRowsWritten      Int       @default(0)
  snapshotsWritten    Int       @default(0)
  coefficientsWritten Int       @default(0)
  trainingRunsWritten Int       @default(0)
  validationSummary   String?
  errorDetails        String?
  generationId        String?

  @@index([generationId], map: "idx_batch_generationId")
  @@index([status], map: "idx_batch_status")
}

model MarketBar {
  ticker      String
  date        String
  open        Float
  high        Float
  low         Float
  close       Float
  volume      Float
  adjusted    Boolean  @default(true)
  source      String
  fetchedAt   DateTime
  batchId     String?
  rawDataHash String

  @@id([ticker, date])
  @@index([ticker])
  @@index([date])
  @@index([batchId], map: "idx_marketbar_batchId")
}

model ScoreSnapshot {
  id                 String   @id @default(cuid())
  ticker             String
  capturedAt         DateTime
  price              Float
  priceChange        Float
  volume             Float
  subAspectScores    String
  aspectScores       String
  subDimensionScores String
  dimensionScores    String
  overall            Float
  grade              String
  signals            String
  ciLower            Float
  ciUpper            Float
  stabilityIndex     Float
  coverage           Float
  isProcessed        Boolean  @default(true)
  dataQuality        String   @default("VALIDATED")
  coefficientVersion String
  rawDataHash        String
  batchId            String?
  generationId       String?
  symbol             Symbol   @relation(fields: [ticker], references: [ticker])

  @@unique([ticker, capturedAt])
  @@index([capturedAt])
  @@index([overall])
  @@index([grade])
  @@index([batchId], map: "idx_snap_batchId")
  @@index([generationId], map: "idx_snap_generationId")
  @@index([capturedAt, generationId, ticker], map: "idx_snap_capt_gen_ticker")
  @@index([capturedAt, overall], map: "idx_snap_capt_overall")
  @@index([capturedAt, grade], map: "idx_snap_capt_grade")
  @@index([capturedAt, generationId, overall], map: "idx_snap_capt_gen_overall")
}

model Coefficient {
  id           String   @id @default(cuid())
  ticker       String
  level        String
  weights      String
  trainedAt    DateTime
  sampleCount  Int
  version      String
  dataHash     String
  driftStatus  String   @default("OK")
  oosR2        Float?
  oosIc        Float?
  shapTopKeys  String?
  meta         String?
  batchId      String?
  generationId String?
  symbol       Symbol   @relation(fields: [ticker], references: [ticker])

  @@unique([ticker, level])
  @@index([ticker])
  @@index([batchId], map: "idx_coeff_batchId")
  @@index([generationId], map: "idx_coeff_generationId")
}

model NewsItem {
  id          String           @id @default(cuid())
  headline    String
  source      String
  url         String?
  publishedAt DateTime
  sentiment   String
  severity    String
  tickers     NewsItemSymbol[]

  @@index([publishedAt])
}

model NewsItemSymbol {
  id         String   @id @default(cuid())
  newsItemId String
  ticker     String
  symbol     Symbol   @relation(fields: [ticker], references: [ticker], onDelete: Cascade)
  newsItem   NewsItem @relation(fields: [newsItemId], references: [id], onDelete: Cascade)

  @@unique([newsItemId, ticker])
}

model Watchlist {
  id        String           @id @default(cuid())
  name      String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  entries   WatchlistEntry[]

  @@index([name])
}

model WatchlistEntry {
  id          String    @id @default(cuid())
  watchlistId String
  ticker      String
  addedAt     DateTime  @default(now())
  symbol      Symbol    @relation(fields: [ticker], references: [ticker], onDelete: Cascade)
  watchlist   Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)

  @@unique([watchlistId, ticker])
}

model Alert {
  id          String    @id @default(cuid())
  ticker      String
  watchlistId String?
  metric      String
  condition   String
  threshold   Float
  active      Boolean   @default(true)
  triggeredAt DateTime?
  createdAt   DateTime  @default(now())
  symbol      Symbol    @relation(fields: [ticker], references: [ticker], onDelete: Cascade)

  @@index([ticker])
  @@index([active])
}

model TrainingRun {
  id           String   @id @default(cuid())
  ticker       String
  level        String
  startedAt    DateTime
  durationMs   Int
  sampleCount  Int
  oosR2        Float?
  oosIc        Float?
  driftPsi     Float?
  regime       String
  status       String
  version      String
  notes        String?
  generationId String?
  batchId      String?

  @@index([ticker])
  @@index([startedAt])
  @@index([batchId], map: "idx_tr_batchId")
  @@index([generationId], map: "idx_tr_generationId")
}

/// Scheduled retrain triggered by drift detection (PSI) or calendar.
model RetrainSchedule {
  id            String    @id @default(cuid())
  ticker        String
  trigger       String    // "drift" | "calendar" | "manual"
  driftPsi      Float?
  scheduledAt   DateTime  @default(now())
  executedAt    DateTime?
  status        String    @default("PENDING")  // PENDING | RUNNING | DONE | SKIPPED
  result        String?
  generationId  String?
  batchId       String?

  @@index([ticker])
  @@index([scheduledAt])
  @@index([status])
  @@index([batchId], map: "idx_rs_batchId")
}

/// Record of a completed retrain run for drift history.
model RetrainRun {
  id            String   @id @default(cuid())
  ticker        String
  level         String
  startedAt     DateTime @default(now())
  durationMs    Int
  sampleCount   Int
  driftPsi      Float?
  prevDriftPsi  Float?
  status        String
  version       String
  notes         String?
  generationId  String?
  batchId       String?
  symbol        Symbol   @relation(fields: [ticker], references: [ticker], onDelete: Cascade)

  @@index([ticker])
  @@index([startedAt])
  @@index([batchId], map: "idx_rr_batchId")
}
