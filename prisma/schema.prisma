generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Symbol {
  ticker           String           @id
  name             String
  exchange         String           @default("NASDAQ")
  sector           String
  industry         String
  marketCap        Float
  isEtf            Boolean          @default(false)
  listedAt         DateTime?
  createdAt        DateTime         @default(now())
  alerts           Alert[]
  coefficients     Coefficient[]
  newsMentions     NewsItemSymbol[]
  metrics          ScoreSnapshot[]
  watchlistEntries WatchlistEntry[]

  @@index([sector])
  @@index([marketCap])
}

model ScoreSnapshot {
  id                 String   @id @default(cuid())
  ticker             String
  capturedAt         DateTime
  price              Float
  priceChange        Float
  volume             Float
  subAspectScores    String
  aspectScores       String
  subDimensionScores String
  dimensionScores    String
  overall            Float
  grade              String
  signals            String
  ciLower            Float
  ciUpper            Float
  stabilityIndex     Float
  coverage           Float
  isProcessed        Boolean  @default(true)
  dataQuality        String   @default("VALIDATED")
  coefficientVersion String
  rawDataHash        String
  symbol             Symbol   @relation(fields: [ticker], references: [ticker])

  @@unique([ticker, capturedAt])
  @@index([capturedAt])
  @@index([overall])
  @@index([grade])
}

model Coefficient {
  id          String   @id @default(cuid())
  ticker      String
  level       String
  weights     String
  trainedAt   DateTime
  sampleCount Int
  version     String
  dataHash    String
  driftStatus String   @default("OK")
  oosR2       Float?
  oosIc       Float?
  shapTopKeys String?
  meta        String?
  symbol      Symbol   @relation(fields: [ticker], references: [ticker])

  @@unique([ticker, level])
  @@index([ticker])
}

model NewsItem {
  id          String           @id @default(cuid())
  headline    String
  source      String
  url         String?
  publishedAt DateTime
  sentiment   String
  severity    String
  tickers     NewsItemSymbol[]

  @@index([publishedAt])
}

model NewsItemSymbol {
  id         String   @id @default(cuid())
  newsItemId String
  ticker     String
  symbol     Symbol   @relation(fields: [ticker], references: [ticker], onDelete: Cascade)
  newsItem   NewsItem @relation(fields: [newsItemId], references: [id], onDelete: Cascade)

  @@unique([newsItemId, ticker])
}

model Watchlist {
  id        String           @id @default(cuid())
  name      String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  entries   WatchlistEntry[]

  @@index([name])
}

model WatchlistEntry {
  id          String    @id @default(cuid())
  watchlistId String
  ticker      String
  addedAt     DateTime  @default(now())
  symbol      Symbol    @relation(fields: [ticker], references: [ticker], onDelete: Cascade)
  watchlist   Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)

  @@unique([watchlistId, ticker])
}

model Alert {
  id          String    @id @default(cuid())
  ticker      String
  watchlistId String?
  metric      String
  condition   String
  threshold   Float
  active      Boolean   @default(true)
  triggeredAt DateTime?
  createdAt   DateTime  @default(now())
  symbol      Symbol    @relation(fields: [ticker], references: [ticker], onDelete: Cascade)

  @@index([ticker])
  @@index([active])
}

model TrainingRun {
  id          String   @id @default(cuid())
  ticker      String
  level       String
  startedAt   DateTime
  durationMs  Int
  sampleCount Int
  oosR2       Float?
  oosIc       Float?
  driftPsi    Float?
  regime      String
  status      String
  version     String
  notes       String?

  @@index([ticker])
  @@index([startedAt])
}
